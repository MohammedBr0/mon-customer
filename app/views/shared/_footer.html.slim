footer.app-footer
  .container
    ul.app-footer__links
      li = link_to t('about'), :about
      li = link_to t('how_it_works'), :how_it_works
      li = link_to t('terms'), :terms
      li = link_to t('privacy'), :privacy
      - if user_signed_in?
        li = link_to Feedback.model_name.human(count: :lot), feedbacks_url
        li = link_to t('delete_account'), user_path(current_user), method: :delete, class: 'text-danger', data: { confirm: t('helpers.links.confirm') }
    p.mt-2.mb-0
      | #{APP_CONFIG.app_name} · #{t('footer.open_source')} ·
      '
      = link_to t('footer.source'), APP_CONFIG.repository_url
