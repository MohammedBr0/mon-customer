header.app-bar.main-navbar
  .container
    .app-bar__inner
      = link_to user_signed_in? ? :dashboard : root_path, class: 'app-bar__brand' do
        = inline_svg_pack_tag 'static/images/logo.svg', aria: true, title: APP_CONFIG.app_name
        span = APP_CONFIG.app_name
      - if user_signed_in?
        nav.app-bar__links aria-label=t('nav.main')
          = link_to t('nav.home'), :dashboard, class: ['app-bar__link', ('active' if current_page?(dashboard_path))]
          = link_to t('nav.search'), itineraries_path, class: ['app-bar__link', ('active' if controller_name == 'itineraries' && action_name == 'index')]
          = link_to t('nav.post'), new_itinerary_path, class: ['app-bar__link', ('active' if controller_name == 'itineraries' && action_name == 'new')]
          = link_to t('bookings.title'), bookings_path, class: ['app-bar__link', ('active' if controller_name == 'bookings')]
        .app-bar__actions
          == render 'shared/notifications'
          .dropdown
            a#main-navbar-dropdown href='#' role='button' data-bs-toggle='dropdown' aria-haspopup='true' aria-expanded='false' aria-label=t('.settings')
              = user_profile_picture current_user, size: 36, options: { class: 'app-bar__avatar' }
            .dropdown-menu.dropdown-menu-end aria-labelledby='main-navbar-dropdown'
              = link_to current_user, user_path(current_user), class: 'dropdown-item fw-bold'
              = link_to t('.account_settings'), :settings, class: 'dropdown-item'
              = link_to t('bookings.title'), bookings_path, class: 'dropdown-item'
              = link_to t('alerts.title'), ride_alerts_path, class: 'dropdown-item'
              .dropdown-divider
              = link_to t('about'), :about, class: 'dropdown-item'
              = link_to t('how_it_works'), :how_it_works, class: 'dropdown-item'
              = link_to Feedback.model_name.human(count: :lot), feedbacks_path, class: 'dropdown-item'
              = link_to t('terms'), :terms, class: 'dropdown-item'
              = link_to t('privacy'), :privacy, class: 'dropdown-item'
              - if current_user.staff?
                .dropdown-divider
                = link_to t('admin_extra.dashboard'), admin_root_path, class: 'dropdown-item'
              .dropdown-divider
              - (I18n.available_locales - [I18n.locale]).each do |locale|
                = link_to t('lang_native_name', locale: locale), url_for(locale: locale), class: 'dropdown-item'
              .dropdown-divider
              = link_to t('logout'), destroy_user_session_path, method: :delete, class: 'dropdown-item text-danger'
      - else
        .app-bar__actions
          .dropdown
            a.app-bar__link#main-navbar-lang-dropdown href='#' role='button' data-bs-toggle='dropdown' aria-haspopup='true' aria-expanded='false'
              span.fas.fa-globe.me-1 aria-hidden='true'
              = t('lang_native_name')
            .dropdown-menu.dropdown-menu-end aria-labelledby='main-navbar-lang-dropdown'
              - (I18n.available_locales - [I18n.locale]).each do |locale|
                = link_to t('lang_native_name', locale: locale), url_for(locale: locale), class: 'dropdown-item'
              .dropdown-divider
              = link_to t('about'), :about, class: 'dropdown-item'
              = link_to t('how_it_works'), :how_it_works, class: 'dropdown-item'
              = link_to t('terms'), :terms, class: 'dropdown-item'
              = link_to t('privacy'), :privacy, class: 'dropdown-item'
          = button_to user_neon_omniauth_authorize_path, form_class: 'd-inline-block', class: 'btn btn-primary btn-sm' do
            = t('login')
