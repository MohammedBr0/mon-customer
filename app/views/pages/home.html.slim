- title t('meta_title')
- content_for :head do
  meta name='description' content=t('meta_description', appname: APP_CONFIG.app_name)

.hero
  .container
    .hero__top
      span.hero__brand = APP_CONFIG.app_name
      .hero__lang
        - (I18n.available_locales - [I18n.locale]).each do |locale|
          = link_to t('lang_native_name', locale: locale), url_for(locale: locale), class: 'ms-3'
    == render 'shared/flash_messages'
    h1 = t('.headline')
    p.hero__lead = t('.lead')
    == render 'login_button'
    .routes
      - %w[addis_adama addis_hawassa addis_bahirdar addis_diredawa].each do |route|
        span.chip = t(".routes.#{route}")
.container
  .benefits
    .benefit
      .benefit__icon: span.fas.fa-coins
      div
        h3 = t('.benefit_save_title')
        p = t('.benefit_save_text')
    .benefit
      .benefit__icon: span.fas.fa-shield-halved
      div
        h3 = t('.benefit_trust_title')
        p = t('.benefit_trust_text')
    .benefit
      .benefit__icon: span.fas.fa-ticket
      div
        h3 = t('.benefit_easy_title')
        p = t('.benefit_easy_text')
