<p><%= t('mailers.message.new_message.greeting', name: @recipient.first_name || @recipient.to_s) %></p>
<p><%= t('mailers.message.new_message.body', sender: @message.sender.to_s) %></p>
<p style="padding:10px 14px;background:#f1f4f7;border-radius:6px;white-space:pre-line;"><%= @message.body %></p>
<p><a href="<%= conversation_url(@conversation) %>" style="display:inline-block;padding:10px 18px;background:#3d7098;color:#fff;border-radius:6px;text-decoration:none;"><%= t('mailers.message.new_message.reply') %></a></p>
