- itinerary = @itinerary
- driver = itinerary.user
- confirmed = user_signed_in? && (current_user == driver || @my_booking&.confirmed?)
- if APP_CONFIG.google_maps_api_key.present? && itinerary.static_map.present?
  .trip-map.mb-3
    = image_tag itinerary.static_map, class: 'google-static-map img-fluid', alt: ''

.surface.mb-3
  .trip-card__route
    .trip-card__stop
      span.trip-card__dot
      span = itinerary.start_address
    .trip-card__line
    .trip-card__stop
      span.trip-card__dot.trip-card__dot--end
      span = itinerary.end_address

dl.facts.mb-3
  - if itinerary.commute?
    .fact.fact--wide
      dt = t('commute.schedule')
      dd
        = itinerary.schedule_summary
        - if itinerary.commute_until
          small.text-body-secondary< = t('commute.until_date', date: l(itinerary.commute_until, format: :long))
  - if itinerary.pickup_point.present? || itinerary.dropoff_point.present?
    .fact.fact--wide
      dt = t('commute.meeting_points')
      dd
        - if itinerary.pickup_point.present?
          span.d-block
            span.fas.fa-location-dot<> aria-hidden='true'
            = "#{t('commute.pickup_point')}: #{itinerary.pickup_point}"
        - if itinerary.dropoff_point.present?
          span.d-block
            span.fas.fa-flag-checkered<> aria-hidden='true'
            = "#{t('commute.dropoff_point')}: #{itinerary.dropoff_point}"
  - unless itinerary.commute?
    .fact
      dt = Itinerary.human_attribute_name :leave_date
      dd = l(itinerary.leave_date.in_time_zone, format: :short)
    - if itinerary.round_trip?
      .fact
        dt = Itinerary.human_attribute_name :return_date
        dd = l(itinerary.return_date.in_time_zone, format: :short)
  .fact
    dt = t('trip.price_per_seat')
    dd = money(itinerary.passenger_price_per_seat)
  .fact
    dt = t('trip.seats')
    dd
      - if itinerary.cancelled?
        = t('bookings.statuses.cancelled')
      - elsif itinerary.seats_available.nil?
        = t('trip.seats_unlimited')
      - elsif itinerary.full?
        span.text-danger = t('trip.fully_booked')
      - else
        = t('trip.seats_left', available: itinerary.seats_available, total: itinerary.num_people)

.surface.mb-3
  .driver-card
    = link_to user_path(driver) do
      = user_profile_picture driver, size: 52
    div
      strong.d-block
        - if user_signed_in?
          = link_to driver, user_path(driver)
        - else
          = t('.app_user', appname: APP_CONFIG.app_name)
        - if driver.verified?
          span.chip.ms-1 title=t('verification.badge_hint')
            span.fas.fa-circle-check aria-hidden='true'
            = t('verification.badge')
      - if driver.reviews_count.positive?
        span.rating
          span.fas.fa-star<> aria-hidden='true'
          = t('reviews.summary', rating: driver.average_rating, count: driver.reviews_count)
      - else
        small.text-body-secondary = t('reviews.none_yet')
  - details = driver.visible_vehicle_details(confirmed: confirmed)
  - if details.any?
    .d-flex.flex-wrap.gap-2.mt-3
      - details.each do |field, value|
        span.chip.chip--muted
          = "#{field.label_for}: #{value}"
  - if confirmed && driver.phone.present? && current_user != driver
    p.mt-3.mb-0
      span.fas.fa-phone<> aria-hidden='true'
      = link_to driver.phone, "tel:#{driver.phone}"
  - if itinerary.description.present?
    p.pre-line.mt-3.mb-0 = itinerary.description
  - if user_signed_in? && current_user != driver
    p.mt-3.mb-0
      = link_to new_report_path(type: 'Itinerary', id: itinerary.id), class: 'text-body-secondary small' do
        span.fas.fa-flag<> aria-hidden='true'
        = t('reports.report_trip')

.d-flex.flex-wrap.gap-2.mb-3
  - if itinerary.pink?
    span.chip.chip--pink
      span.fas.fa-lock<> aria-hidden='true'
      = Itinerary.human_attribute_name(:pink)
  span.chip class=('chip--muted' unless itinerary.smoking_allowed?)
    span.fas class=(itinerary.smoking_allowed? ? 'fa-check' : 'fa-ban-smoking') aria-hidden='true'
    = t(".smoking.#{itinerary.smoking_allowed? ? 'allowed' : 'forbidden'}")
  span.chip class=('chip--muted' unless itinerary.pets_allowed?)
    span.fas class=(itinerary.pets_allowed? ? 'fa-paw' : 'fa-ban') aria-hidden='true'
    = t(".pets.#{itinerary.pets_allowed? ? 'allowed' : 'forbidden'}")
