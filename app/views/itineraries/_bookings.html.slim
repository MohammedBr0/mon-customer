#booking.stack
  - if current_user == @itinerary.user
    h2.section-title = t('bookings.requests_title')
    - if @driver_bookings.blank?
      .surface.empty
        span.fas.fa-ticket aria-hidden='true'
        = t('bookings.no_requests')
    - else
      - @driver_bookings.each do |booking|
        .surface
          .row-card
            .row-card__main
              span.row-card__title = link_to booking.passenger, user_path(booking.passenger)
              small.text-body-secondary = t('bookings.seats_count', count: booking.seats)
              - if booking.note.present?
                small.d-block.text-body-secondary = booking.note
              - if booking.confirmed? && booking.passenger.phone.present?
                small.d-block
                  span.fas.fa-phone<> aria-hidden='true'
                  = link_to booking.passenger.phone, "tel:#{booking.passenger.phone}"
            == render 'bookings/status', booking: booking
          == render 'bookings/dates', booking: booking, allow_skip: booking.active?
          == render 'bookings/breakdown', breakdown: booking.price_breakdown, role: :driver
          .row-card__actions
            - if booking.pending?
              = button_to confirm_booking_path(booking), method: :patch, class: 'btn btn-primary btn-sm' do
                span.fas.fa-check aria-hidden='true'
                = t('bookings.confirm')
              = button_to decline_booking_path(booking), method: :patch, class: 'btn btn-outline-secondary btn-sm' do
                span.fas.fa-times aria-hidden='true'
                = t('bookings.decline')
            - elsif booking.confirmed?
              = button_to cancel_booking_path(booking), method: :patch, class: 'btn btn-outline-danger btn-sm', data: { confirm: t('bookings.cancel_confirm') } do
                = t('bookings.cancel')
              - if booking.completed? && !booking.reviewed_by?(current_user)
                = link_to t('reviews.rate_passenger'), new_booking_review_path(booking), class: 'btn btn-outline-primary btn-sm'
  - elsif @my_booking&.active?
    h2.section-title = t('bookings.your_booking')
    .surface
      .row-card
        .row-card__main
          span.row-card__title = t('bookings.seats_count', count: @my_booking.seats)
        == render 'bookings/status', booking: @my_booking
      == render 'bookings/dates', booking: @my_booking, allow_skip: true
      == render 'bookings/breakdown', breakdown: @my_booking.price_breakdown, role: :passenger
      - if @my_booking.confirmed?
        p.mb-2
          span.fas.fa-wallet<> aria-hidden='true'
          = platform_setting.payment_instructions
      .row-card__actions
        = button_to cancel_booking_path(@my_booking), method: :patch, class: 'btn btn-outline-danger btn-sm', data: { confirm: t('bookings.cancel_confirm') } do
          = t('bookings.cancel')
        - if @my_booking.completed? && !@my_booking.reviewed_by?(current_user)
          = link_to t('reviews.rate_driver'), new_booking_review_path(@my_booking), class: 'btn btn-outline-primary btn-sm'
  - elsif @itinerary.bookable_by?(current_user)
    h2.section-title = t('bookings.request_title')
    .surface data-price-calc=true data-price=@itinerary.price_per_seat data-fee-percent=platform_setting.fee_percent data-charged-to=platform_setting.fee_charged_to data-symbol=platform_setting.currency_symbol
      = form_with url: itinerary_bookings_path(@itinerary), scope: :booking do |f|
        - open_dates = @itinerary.occurrence_dates.reject { |date| @itinerary.full?(date) }
        - max_seats = [open_dates.filter_map { |date| @itinerary.seats_available(date) }.min || Booking::MAX_SEATS, Booking::MAX_SEATS].min
        - if @itinerary.commute?
          .mb-3
            label.form-label = t('commute.choose_days')
            .d-flex.flex-wrap.gap-2
              - open_dates.each_with_index do |date, index|
                = check_box_tag 'booking[ride_dates][]', date.iso8601, index < 5, id: "ride_date_#{date.iso8601}", class: 'btn-check', data: { price_dates: true }
                = label_tag "ride_date_#{date.iso8601}", l(date, format: :short_day), class: 'btn btn-outline-primary btn-sm'
            p.form-text.mb-0 = t('commute.choose_days_hint')
        .mb-3
          = f.label :seats, t('bookings.seats'), class: 'form-label'
          = f.select :seats, (1..[max_seats, 1].max).to_a, {}, class: 'form-select'
        == render 'bookings/breakdown', breakdown: @itinerary.price_breakdown(1, @itinerary.commute? ? [open_dates.size, 5].min : 1), role: :passenger
        .mb-3
          = f.label :note, t('bookings.note'), class: 'form-label'
          = f.text_field :note, class: 'form-control', maxlength: Booking::MAX_NOTE_LENGTH, placeholder: t('bookings.note_placeholder')
        p.form-text
          span.fas.fa-wallet<> aria-hidden='true'
          = platform_setting.payment_instructions
        = f.button class: 'btn btn-primary btn-lg w-100', data: { disable_with: t('helpers.disable_with') } do
          span.fas.fa-ticket aria-hidden='true'
          = t('bookings.request')
  - elsif @itinerary.full? && !@itinerary.cancelled?
    .surface.empty = t('trip.fully_booked')
  - if @my_booking.present? && !@my_booking.active? && !@itinerary.bookable_by?(current_user)
    .surface
      == render 'bookings/status', booking: @my_booking
  - if @my_booking&.completed? && @my_booking.reviewed_by?(current_user)
    p.text-body-secondary = t('reviews.thanks')
