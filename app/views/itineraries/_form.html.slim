fieldset#single
  .mb-3
    = f.input :leave_date, as: :datetime, default: default_leave_date, start_year: Time.current.year, end_year: 1.year.from_now.year, minute_step: 10, ampm: t('time.ampm'), input_html: { class: 'date-time form-select d-inline-block w-auto' }
  = f.input :round_trip, as: :boolean
  .mb-3
    = f.input :return_date, as: :datetime, default: default_leave_date, start_year: Time.current.year, end_year: 1.year.from_now.year, minute_step: 10, ampm: t('time.ampm'), input_html: { class: 'date-time form-select d-inline-block w-auto' }, disabled: !@itinerary.round_trip
  .row
    .col-sm-6
      = f.input :num_people, collection: (1..8).to_a, include_blank: false, selected: (f.object.num_people || 3), label: t('trip.free_seats'), hint: t('trip.free_seats_hint')
    .col-sm-6
      = f.input :price_per_seat, label: t('trip.your_price') do
        .input-group
          = f.text_field :price_per_seat, class: 'form-control text-end', inputmode: 'decimal', placeholder: '0'
          span.input-group-text = platform_setting.currency_symbol
        p.form-text.mb-0
          - if platform_setting.fee_charged_to_passenger?
            = t('trip.fee_hint_passenger', percent: number_with_precision(platform_setting.fee_percent, precision: 2, strip_insignificant_zeros: true))
          - else
            = t('trip.fee_hint_driver', percent: number_with_precision(platform_setting.fee_percent, precision: 2, strip_insignificant_zeros: true))
        p.form-text.mb-0#fuel-help data-avg-consumption=current_user.vehicle_avg_consumption
          small#fuel-help-text
  = f.input :description, as: :text, input_html: { rows: 4, maxlength: Itinerary::MAX_DESCRIPTION_LENGTH }, hint: t('.description_hint')
  .mb-3
    - if current_user.female?
      = f.input :pink, as: :boolean, hint: t('.pink_hint'), wrapper: false, form_check_wrapper_html: { class: 'mb-2' }
    = f.input :smoking_allowed, as: :boolean, wrapper_class: false, form_check_wrapper_html: { class: 'mb-2' }
    = f.input :pets_allowed, as: :boolean, wrapper: false

/
  fieldset#daily.hide.mock
    .control-group
      .controls
        table.table.table-condensed.daily-itinerary-table
          thead
            tr
              th
              th= t('.day')
              th= t('.leave_time')
              th= t('.return_time')
          tbody
            - (0..6).each_with_index do |index|
              tr
                td
                  p.text-center
                    = check_box_tag "day-#{index}"
                td= label_tag "day-# index ", t('date.day_names')[index]
                td
                  = time_select 'one', 'two', { minute_step: 10, default: { hour: 8 }, ampm: t('time.ampm') }, class: 'date-time', disabled: (index > 0)
                td
                  = time_select 'one', 'two', { minute_step: 10, default: { hour: 18 }, ampm: t('time.ampm') }, class: 'date-time', disabled: (index > 0)
          tfoot
            tr
              td colspan="2"
              td colspan="2"
                = label_tag 'edit-all-times', class: 'checkbox inline' do
                  = check_box_tag 'edit-all-times', nil, checked: true
                  = t('.edit_all_times')

/
  .control-group.hide
    .controls
      = label_tag nil, class: 'radio inline' do
        = f.input, :daily, false, as: :radio, checked: true
        = t('.single_itinerary')
      | &nbsp;
      = label_tag nil, class: 'radio inline mock' do
        = f.default_tag :radio_button, :daily, true, class: 'inline'
        = t('.daily_itinerary')
