- title @itinerary.title
== render 'opengraph_head_contents', itinerary: @itinerary
- if user_signed_in? && current_user != @itinerary.user && @itinerary.bookable_by?(current_user) && @my_booking.nil?
  - content_for :sticky_cta do
    .sticky-cta
      .container
        .sticky-cta__inner
          .sticky-cta__price
            strong = money(@itinerary.passenger_price_per_seat)
            small = t('trip.per_seat')
          = link_to "#booking", class: 'btn btn-primary' do
            span.fas.fa-ticket aria-hidden='true'
            = t('bookings.request')
.container
  == render 'shared/flash_messages'
  - if @itinerary.cancelled?
    .alert.alert-warning role='alert'
      span.fas.fa-ban<> aria-hidden='true'
      = t('trip.cancelled_banner')
  == render 'header'
  - if user_signed_in?
    - if current_user == @itinerary.user
      .d-flex.flex-wrap.gap-2.mb-3
        = link_to edit_itinerary_path(@itinerary), class: 'btn btn-outline-primary' do
          span.fas.fa-pencil-alt aria-hidden='true'
          = t('helpers.titles.edit', model: Itinerary.model_name.human)
        - unless @itinerary.cancelled?
          = button_to cancel_itinerary_path(@itinerary), method: :patch, form_class: 'd-inline-block', class: 'btn btn-outline-danger', data: { confirm: t('trip.cancel_confirm') } do
            span.fas.fa-ban aria-hidden='true'
            = t('trip.cancel_trip')
    - else
      = link_to new_or_show_conversation_path(@conversation), class: 'btn btn-outline-primary mb-3' do
        span.fas.fa-comment aria-hidden='true'
        = t('.contact', user: @itinerary.user_first_name)
    == render 'itineraries/bookings'
  - else
    = button_to user_neon_omniauth_authorize_path, form_class: 'd-block', class: 'btn btn-primary btn-lg w-100' do
      = t('.login_to_contact')
