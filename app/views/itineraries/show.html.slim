- title @itinerary.title
== render 'opengraph_head_contents', itinerary: @itinerary
.container
  == render 'shared/flash_messages'
  - if @itinerary.cancelled?
    .alert.alert-warning role='alert'
      span.fas.fa-ban<>
      = t('trip.cancelled_banner')
  == render 'header'
  - if user_signed_in?
    - if current_user == @itinerary.user
      = link_to edit_itinerary_path(@itinerary), class: 'btn btn-primary me-2' do
        span.fas.fa-pencil-alt<>
        = t('helpers.titles.edit', model: Itinerary.model_name.human)
      - unless @itinerary.cancelled?
        = button_to cancel_itinerary_path(@itinerary), method: :patch, form_class: 'd-inline-block', class: 'btn btn-outline-danger', data: { confirm: t('trip.cancel_confirm') } do
          span.fas.fa-ban<>
          = t('trip.cancel_trip')
    - else
      = link_to new_or_show_conversation_path(@conversation), class: 'btn btn-primary me-2' do
        span.fas.fa-comment<>
        = t('.contact', user: @itinerary.user_first_name)
      /
        .btn-group
          button.btn.btn-warning
            span.fas.fa-flag<>
          button.btn.btn-warning.dropdown-toggle data-bs-toggle='dropdown'
            span.caret
          ul.dropdown-menu role='menu'
            li= link_to t('.report_itinerary'), '#'
    == render 'itineraries/bookings'
  - else
    = button_to user_neon_omniauth_authorize_path, form_class: 'd-inline-block', class: 'btn btn-primary btn-lg' do
      = t('.login_to_contact')
