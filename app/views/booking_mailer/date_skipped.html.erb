<p><%= t('mailers.booking.date_skipped.greeting', name: @recipient.first_name || @recipient.to_s) %></p>
<p><%= t('mailers.booking.date_skipped.body', by: @cancelled_by.to_s, date: l(@date, format: :long), trip: @booking.itinerary.title) %></p>
<p><a href="<%= itinerary_url(@booking.itinerary) %>" style="display:inline-block;padding:10px 18px;background:#0b7a4b;color:#fff;border-radius:6px;text-decoration:none;"><%= t('mailers.view_trip') %></a></p>
