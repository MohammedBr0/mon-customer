<p><%= t('mailers.booking.declined.greeting', name: @recipient.first_name || @recipient.to_s) %></p>
<p><%= t('mailers.booking.declined.body', passenger: @booking.passenger.to_s, driver: @booking.driver.to_s, trip: @booking.itinerary.title, seats: @booking.seats, by: (@cancelled_by || @booking.driver).to_s) %></p>
<% if @booking.note.present? && 'declined' == 'requested' %><p style="padding:10px 14px;background:#f1f4f7;border-radius:6px;"><%= @booking.note %></p><% end %>
<p><a href="<%= itinerary_url(@booking.itinerary) %>" style="display:inline-block;padding:10px 18px;background:#3d7098;color:#fff;border-radius:6px;text-decoration:none;"><%= t('mailers.view_trip') %></a></p>
