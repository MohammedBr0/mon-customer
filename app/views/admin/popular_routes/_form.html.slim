= form_with model: route, url: (route.persisted? ? admin_popular_route_path(route) : admin_popular_routes_path), scope: :popular_route, class: 'surface stack' do |f|
  - if route.errors.any?
    .alert.alert-danger
      ul.mb-0
        - route.errors.full_messages.each do |message|
          li = message
  div
    = f.label :from_label, t('admin_extra.route_from'), class: 'form-label'
    = f.text_field :from_label, class: 'form-control', maxlength: 60, required: true
  div
    = f.label :to_label, t('admin_extra.route_to'), class: 'form-label'
    = f.text_field :to_label, class: 'form-control', maxlength: 60, required: true
  .form-check
    = f.check_box :active, class: 'form-check-input'
    = f.label :active, t('admin_extra.active_field'), class: 'form-check-label'
  .d-flex.gap-2
    = f.button class: 'btn btn-primary btn-lg flex-grow-1' do
      = t('save')
    = link_to t('helpers.links.back'), admin_popular_routes_path, class: 'btn btn-outline-secondary btn-lg'
