- title t('admin_extra.popular_routes')
.container
  == render 'admin/nav'
  == render 'shared/flash_messages'
  .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2
    h1.page-title.mb-0 = yield :title
    = link_to new_admin_popular_route_path, class: 'btn btn-primary' do
      span.fas.fa-plus aria-hidden='true'
      = t('admin_extra.add_route')
  p.text-body-secondary.mt-2 = t('admin_extra.popular_routes_intro')
  - if @routes.empty?
    .surface.empty = t('admin_extra.no_routes')
  - else
    .stack
      - @routes.each_with_index do |route, index|
        .surface class=('opacity-50' unless route.active?)
          .row-card
            .row-card__main
              span.row-card__title = route
              - unless route.active?
                span.chip.chip--muted = t('admin_extra.inactive')
            .row-card__actions
              - if index.positive?
                = button_to move_admin_popular_route_path(route, direction: 'up'), method: :patch, class: 'btn btn-outline-secondary btn-sm' do
                  span.fas.fa-arrow-up aria-label=t('admin_extra.move_up')
              - if index < @routes.size - 1
                = button_to move_admin_popular_route_path(route, direction: 'down'), method: :patch, class: 'btn btn-outline-secondary btn-sm' do
                  span.fas.fa-arrow-down aria-label=t('admin_extra.move_down')
              = link_to t('helpers.links.edit'), edit_admin_popular_route_path(route), class: 'btn btn-outline-primary btn-sm'
              = button_to t('helpers.links.destroy'), admin_popular_route_path(route), method: :delete, class: 'btn btn-outline-danger btn-sm', data: { confirm: t('helpers.links.confirm') }
