- title t('admin_extra.users')
.container
  == render 'admin/nav'
  == render 'shared/flash_messages'
  h1.page-title
    = yield :title
    small.text-body-secondary< = @users.total_count
  = form_with url: admin_users_path, method: :get, class: 'filter-bar' do |f|
    = f.search_field :q, value: params[:q], placeholder: t('admin_extra.search_users'), class: 'form-control', style: 'max-width: 320px'
    = f.select :filter, [[t('admin_extra.filters.all'), ''], [t('admin_extra.filters.banned'), 'banned'], [t('admin_extra.filters.verified'), 'verified'], [t('admin_extra.filters.unverified'), 'unverified'], [t('admin_extra.filters.staff'), 'staff']], { selected: params[:filter] }, class: 'form-select', style: 'max-width: 200px'
    = f.button t('admin_extra.filter'), class: 'btn btn-primary'
  .stack
    - @users.each do |user|
      .surface
        .row-card
          .row-card__main
            span.row-card__title = link_to user, admin_user_path(user)
            small.text-body-secondary = [user.email, user.phone].compact_blank.join(' · ')
            .d-flex.flex-wrap.gap-1.mt-1
              - if user.admin?
                span.chip = t('admin_extra.roles.admin')
              - elsif user.moderator?
                span.chip = t('admin_extra.roles.moderator')
              - if user.verified?
                span.chip
                  span.fas.fa-circle-check<> aria-hidden='true'
                  = t('verification.badge')
              - if user.banned?
                span.chip.chip--danger = t('admin_extra.banned')
          .row-card__actions
            = link_to t('admin_extra.view'), admin_user_path(user), class: 'btn btn-outline-primary btn-sm'
  == paginate @users
