- title t('admin_extra.dashboard')
.container
  == render 'shared/flash_messages'
  .page-header
    h1 = yield :title
  .row.g-3.mb-4
    - { users: @stats[:users], banned_users: @stats[:banned_users], itineraries: @stats[:itineraries], upcoming_itineraries: @stats[:upcoming_itineraries], cancelled_itineraries: @stats[:cancelled_itineraries], conversations: @stats[:conversations], reviews: @stats[:reviews], average_rating: (@stats[:average_rating] || '-') }.each do |key, value|
      .col-6.col-md-3
        .surface.h-100
          .fs-3.fw-bold = value
          .text-body-secondary = t("admin_extra.stats.#{key}")
  h2.section-title = t('admin_extra.stats.money')
  .row.g-3.mb-4
    .col-6
      .surface
        .fs-3.fw-bold = money(@stats[:gross_fares])
        .text-body-secondary = t('admin_extra.stats.gross_fares')
    .col-6
      .surface
        .fs-3.fw-bold = money(@stats[:platform_fees])
        .text-body-secondary = t('admin_extra.stats.platform_fees', percent: number_with_precision(platform_setting.fee_percent, precision: 2, strip_insignificant_zeros: true))
  h2.section-title = t('admin_extra.stats.bookings')
  ul.list-inline
    - Booking::STATUSES.each do |status|
      li.list-inline-item.me-4
        strong = @stats[:bookings].fetch(status, 0)
        '
        = t("bookings.statuses.#{status}")
  p.mt-4
    = link_to t('admin_extra.platform_settings'), admin_settings_path, class: 'btn btn-primary me-2 mb-2'
    = link_to t('admin_extra.vehicle_fields'), admin_vehicle_fields_path, class: 'btn btn-outline-primary me-2 mb-2'
    = link_to t('admin_extra.manage_users'), admin_users_path, class: 'btn btn-outline-primary me-2 mb-2'
    = link_to t('admin_extra.itineraries'), admin_itineraries_path, class: 'btn btn-outline-primary mb-2'
