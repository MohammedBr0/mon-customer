- title t('admin_extra.dashboard')
.container
  == render 'shared/flash_messages'
  .admin-hello
    div
      h1.page-title.mb-1 = t('admin_dash.hello', name: current_user.first_name.presence || current_user.to_s)
      p.text-body-secondary.mb-0 = t('admin_dash.subtitle', date: l(Time.zone.today, format: :long))

  / What needs a decision today
  - attention = [[:pending_documents, admin_identity_documents_path, 'id-card'], [:open_reports, admin_reports_path, 'flag'], [:pending_bookings, admin_bookings_path, 'hourglass-half']]
  h2.section-title = t('admin_dash.attention')
  .row.g-3.mb-4
    - attention.each do |key, path, icon|
      - count = @stats[key]
      .col-12.col-md-4
        = link_to path, class: ['attention-card', ('attention-card--clear' if count.zero?)] do
          span.attention-card__icon
            span.fas class="fa-#{icon}" aria-hidden='true'
          span.attention-card__body
            strong = count
            span = t("admin_dash.attention_items.#{key}")
          span.fas.fa-chevron-right.attention-card__go aria-hidden='true'

  / The platform at a glance
  h2.section-title = t('admin_dash.at_a_glance')
  - kpis = [[:users, 'users', admin_users_path, t('admin_dash.this_week', count: @stats[:new_users_week])], [:drivers, 'car-side', admin_users_path, t('admin_dash.verified', count: @stats[:verified_drivers])], [:upcoming_itineraries, 'route', admin_itineraries_path, t('admin_dash.this_week', count: @stats[:new_trips_week])], [:commutes, 'rotate', admin_itineraries_path, nil], [:average_rating, 'star', admin_reviews_path, t('admin_dash.reviews', count: @stats[:reviews])], [:ride_alerts, 'bell', nil, nil], [:conversations, 'comments', nil, nil], [:banned_users, 'ban', admin_users_path(filter: 'banned'), nil]]
  .row.g-3.mb-4
    - kpis.each do |key, icon, path, note|
      .col-6.col-lg-3
        = link_to_if path, capture { render 'admin/dashboard/kpi', value: @stats[key], label: t("admin_dash.kpi.#{key}"), icon: icon, note: note }, path, class: 'kpi-link' do
          = render 'admin/dashboard/kpi', value: @stats[key], label: t("admin_dash.kpi.#{key}"), icon: icon, note: note

  .row.g-3.mb-4
    - if current_user.super_admin?
      .col-12.col-lg-5
        .surface.h-100
          h2.section-title.mt-0 = t('admin_extra.stats.money')
          .money-row
            span = t('admin_extra.stats.gross_fares')
            strong = money(@stats[:gross_fares])
          .money-row
            span = t('admin_extra.stats.platform_fees', percent: number_with_precision(platform_setting.fee_percent, precision: 2, strip_insignificant_zeros: true))
            strong.text-primary = money(@stats[:platform_fees])
          = link_to t('admin_extra.platform_settings'), admin_settings_path, class: 'btn btn-outline-primary btn-sm mt-3'
    .col-12 class=(current_user.super_admin? ? 'col-lg-7' : '')
      .surface.h-100
        h2.section-title.mt-0 = t('admin_extra.stats.bookings')
        - total = [@stats[:bookings].values.sum, 1].max
        - Booking::STATUSES.each do |status|
          - count = @stats[:bookings].fetch(status, 0)
          .bar-row
            span.bar-row__label = t("bookings.statuses.#{status}")
            span.bar-row__track
              span.bar-row__fill class="bar-row__fill--#{status}" style="width: #{(count * 100.0 / total).round}%"
            strong.bar-row__value = count

  .row.g-3
    .col-12.col-lg-6
      .surface.h-100
        .d-flex.justify-content-between.align-items-center
          h2.section-title.my-0 = t('admin_dash.new_people')
          = link_to t('admin_dash.see_all'), admin_users_path, class: 'small'
        .mini-list
          - @recent_users.each do |user|
            = link_to admin_user_path(user), class: 'mini-list__row' do
              = user_profile_picture user, size: 34, options: { class: 'app-bar__avatar' }
              span.mini-list__main
                strong = user.to_s
                small = [t("admin_dash.mode.#{user.app_mode}"), time_ago_in_words(user.created_at)].join(' · ')
              - if user.verified?
                span.chip
                  span.fas.fa-circle-check aria-hidden='true'
    .col-12.col-lg-6
      .surface.h-100
        .d-flex.justify-content-between.align-items-center
          h2.section-title.my-0 = t('admin_dash.new_trips')
          = link_to t('admin_dash.see_all'), admin_itineraries_path, class: 'small'
        .mini-list
          - if @recent_trips.empty?
            p.text-body-secondary.mb-0.mt-2 = t('trip.empty')
          - @recent_trips.each do |trip|
            = link_to itinerary_path(trip), class: 'mini-list__row' do
              span.mini-list__icon
                span.fas.fa-route aria-hidden='true'
              span.mini-list__main
                strong = trip.title
                small = [trip.user.to_s, money(trip.price_per_seat), time_ago_in_words(trip.created_at)].join(' · ')
              - if trip.cancelled?
                span.chip.chip--muted = t('bookings.statuses.cancelled')
