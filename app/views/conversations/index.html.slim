- title t('.title')
.container
  h1.page-title = yield :title
  - if @conversations.empty?
    .surface.empty
      span.fas.fa-comments aria-hidden='true'
      = t('conversations.empty')
  - else
    .stack
      - @conversations.each do |conversation|
        = link_to conversation_path(conversation), class: 'surface text-decoration-none text-reset' do
          .row-card
            .row-card__main
              span.row-card__title = conversation.with(current_user)
              small.text-body-secondary = conversation.conversable.try(:title)
            - if conversation.unread?(current_user)
              span.chip = t('conversations.new')
  == paginate @conversations
