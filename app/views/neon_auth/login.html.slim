doctype html
html lang=I18n.locale.to_s
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    title = "#{APP_CONFIG.app_name} - #{t('login')}"
    = stylesheet_pack_tag 'application', media: 'all'
  body.bg-light
    .container
      .row.justify-content-center.pt-5
        .col-12.col-md-6.col-lg-4
          h1.h3.mb-4.text-center = APP_CONFIG.app_name
          #neon-auth-login data-issuer=APP_CONFIG.neon_auth.issuer data-start-path=user_neon_omniauth_authorize_path
            .alert.alert-danger.d-none role='alert' data-role='error'
            form.card.card-body data-role='form' novalidate=true
              .mb-3.d-none data-role='name-group'
                label.form-label for='neon-name' Name
                input#neon-name.form-control type='text' name='name' autocomplete='name'
              .mb-3
                label.form-label for='neon-email' Email
                input#neon-email.form-control type='email' name='email' required=true autocomplete='email'
              .mb-3
                label.form-label for='neon-password' Password
                input#neon-password.form-control type='password' name='password' required=true minlength=8 autocomplete='current-password'
              button.btn.btn-primary.w-100 type='submit' data-role='submit' Sign in
              button.btn.btn-link.w-100.mt-2 type='button' data-role='toggle' Create an account
    javascript:
      (function () {
        var root = document.getElementById('neon-auth-login');
        var issuer = root.dataset.issuer;
        var oauthQuery = window.location.search.slice(1);
        var form = root.querySelector('[data-role=form]');
        var errorBox = root.querySelector('[data-role=error]');
        var nameGroup = root.querySelector('[data-role=name-group]');
        var submit = root.querySelector('[data-role=submit]');
        var toggle = root.querySelector('[data-role=toggle]');
        var signUp = false;

        // Opened directly rather than redirected by Neon Auth: start the flow from the app.
        if (!oauthQuery) {
          var start = document.createElement('form');
          start.method = 'post';
          start.action = root.dataset.startPath;
          var token = document.querySelector('meta[name=csrf-token]');
          if (token) {
            var input = document.createElement('input');
            input.type = 'hidden'; input.name = 'authenticity_token'; input.value = token.content;
            start.appendChild(input);
          }
          document.body.appendChild(start);
          start.submit();
          return;
        }

        function showError(message) {
          errorBox.textContent = message;
          errorBox.classList.remove('d-none');
        }

        function post(path, body) {
          return fetch(issuer + path, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
          });
        }

        // Resumes the authorization request; navigates to the client's redirect URI or the consent page.
        function resume() {
          return post('/oauth2/continue', { selected: true, oauth_query: oauthQuery })
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (data) {
              if (data && data.url) { window.location.assign(data.url); return true; }
              return false;
            });
        }

        function signIn(email, password) {
          return post('/sign-in/email', { email: email, password: password, oauth_query: oauthQuery })
            .then(function (res) {
              return res.json().catch(function () { return {}; }).then(function (data) {
                if (!res.ok) { throw new Error(data.message || 'Invalid email or password'); }
                if (data && data.url) { window.location.assign(data.url); return; }
                return resume().then(function (done) {
                  if (!done) { throw new Error('Signed in, but could not continue. Please try again.'); }
                });
              });
            });
        }

        function signUpThenIn(name, email, password) {
          return post('/sign-up/email', { name: name, email: email, password: password })
            .then(function (res) {
              return res.json().catch(function () { return {}; }).then(function (data) {
                if (!res.ok) { throw new Error(data.message || 'Could not create the account'); }
                return signIn(email, password);
              });
            });
        }

        toggle.addEventListener('click', function () {
          signUp = !signUp;
          nameGroup.classList.toggle('d-none', !signUp);
          root.querySelector('#neon-name').required = signUp;
          root.querySelector('#neon-password').autocomplete = signUp ? 'new-password' : 'current-password';
          submit.textContent = signUp ? 'Create account' : 'Sign in';
          toggle.textContent = signUp ? 'I already have an account' : 'Create an account';
          errorBox.classList.add('d-none');
        });

        form.addEventListener('submit', function (event) {
          event.preventDefault();
          errorBox.classList.add('d-none');
          var data = new FormData(form);
          submit.disabled = true;
          var work = signUp
            ? signUpThenIn(data.get('name'), data.get('email'), data.get('password'))
            : signIn(data.get('email'), data.get('password'));
          work.catch(function (error) { showError(error.message); })
              .then(function () { submit.disabled = false; });
        });

        // Already signed in to Neon Auth: skip the form.
        resume();
      })();
