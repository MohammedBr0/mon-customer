doctype html
html lang=I18n.locale.to_s
  head
    meta charset='utf-8'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta name='robots' content='noindex'
    title = "#{APP_CONFIG.app_name} · #{yield(:title)}"
    = csrf_meta_tags
    = stylesheet_pack_tag 'application', media: 'all'
    css:
      :root { --brand: #0b7a4b; --brand-dark: #096440; }
      body.neon-auth {
        min-height: 100vh; margin: 0; display: flex; align-items: center; justify-content: center;
        padding: 1.5rem 1rem; background: linear-gradient(160deg, #e8f5ee 0%, #f8fafc 60%);
      }
      .na-wrap { width: 100%; max-width: 400px; }
      .na-brand { text-align: center; margin-bottom: 1.5rem; }
      .na-brand a { color: var(--brand); font-weight: 800; letter-spacing: -.02em; font-size: 2rem; text-decoration: none; }
      .na-card {
        background: #fff; border-radius: 14px; padding: 2rem 1.75rem;
        box-shadow: 0 10px 30px rgba(20, 60, 40, .12);
      }
      .na-card h1 { font-size: 1.35rem; font-weight: 700; margin: 0 0 .25rem; color: #1f2d3a; }
      .na-sub { color: #6b7a88; font-size: .95rem; margin-bottom: 1.5rem; }
      .na-card .form-control { padding: .7rem .85rem; border-radius: 8px; }
      .na-card .form-control:focus { border-color: var(--brand); box-shadow: 0 0 0 .2rem rgba(11, 122, 75, .2); }
      .na-card label { font-size: .85rem; font-weight: 600; color: #3b4a58; margin-bottom: .3rem; }
      .na-btn {
        width: 100%; padding: .75rem; border: 0; border-radius: 8px; font-weight: 600;
        color: #fff; background: var(--brand); transition: background .15s;
      }
      .na-btn:hover:not(:disabled) { background: var(--brand-dark); }
      .na-btn:disabled { opacity: .65; cursor: progress; }
      .na-btn-secondary { background: transparent; color: #6b7a88; margin-top: .25rem; }
      .na-btn-secondary:hover:not(:disabled) { background: #f1f4f7; }
      .na-switch { text-align: center; margin-top: 1.25rem; font-size: .9rem; color: #6b7a88; }
      .na-switch button { border: 0; background: none; padding: 0; color: var(--brand); font-weight: 600; }
      .na-switch button:hover { text-decoration: underline; }
      .na-back { text-align: center; margin-top: 1.25rem; font-size: .85rem; }
      .na-back a { color: #6b7a88; text-decoration: none; }
      .na-back a:hover { color: var(--brand); }
  body.neon-auth
    .na-wrap
      .na-brand = link_to APP_CONFIG.app_name, root_path
      == yield
      .na-back = link_to '← Back to home', root_path
